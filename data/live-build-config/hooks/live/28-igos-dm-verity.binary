#!/bin/sh
# igOS: dm-verity — seal the root squashfs and bake its root hash into the
# per-image live initramfs.
#
# WHY (this is a .binary hook, not .chroot)
#   dm-verity must hash the FINAL root filesystem, so it can only run once the
#   squashfs exists. live-build builds live/filesystem.squashfs during
#   `lb binary`, and binary hooks run with CWD at the ISO image tree root (the
#   dir holding live/, boot/, isolinux/) -- so live/filesystem.squashfs and
#   live/initrd.img here are the final artifacts (cf. 26-igos-dtb.binary and
#   27-igos-uboot.binary). Numbered 28 so it runs after them.
#
# WHAT
#   1. Append a dm-verity hash tree to the END of live/filesystem.squashfs. The
#      squashfs superblock fixes the mounted size, so the trailing hash tree is
#      inert to a normal (non-verity) squashfs mount -- non-verity boots are
#      unaffected and the filesystem stays a single self-contained file that the
#      installer can copy verbatim to /boot/<version>/<version>.squashfs.
#   2. Capture the verity ROOT HASH and cpio-append it (plus the hash offset and
#      geometry) into live/initrd.img at /etc/verity/params. The root hash thus
#      rides INSIDE the initramfs that grub verifies -- it is the trust anchor,
#      never read from writable storage. The init-premount hook igos-verity-root
#      reads these params at boot, opens /dev/mapper/verity-root fail-closed, and
#      the `plainroot root=/dev/mapper/verity-root` cmdline hands it to live-boot.
#
# GATING
#   Runs only for verity flavors, detected (like 27-igos-uboot.binary keys off
#   the u-boot payload in the rootfs) by veritysetup being present in the sibling
#   chroot -- i.e. cryptsetup-bin was pulled in by `dm_verity = true`. On any
#   other image this is a no-op.
#
# REQUIREMENT
#   veritysetup must be available on the BUILD HOST (the aarch64 build container
#   needs cryptsetup-bin). For a verity flavor its absence is a HARD build
#   failure -- we must never ship a verity image without a sealed root hash.

set -e

SQUASHFS="live/filesystem.squashfs"
INITRD="live/initrd.img"
BS=4096
VERITY_NAME="verity-root"
SQUASHFS_NAME="filesystem.squashfs"

# --- gate: is this a verity flavor? (sibling chroot carries veritysetup) -----
CHROOT=""
for c in ../chroot chroot ../../chroot; do
    if [ -x "${c}/usr/sbin/veritysetup" ] || [ -x "${c}/sbin/veritysetup" ]; then
        CHROOT="${c}"
        break
    fi
done
if [ -z "${CHROOT}" ]; then
    echo "I: dm-verity(iso): veritysetup not in chroot -- not a verity flavor, nothing to do"
    exit 0
fi

echo "I: dm-verity(iso): verity flavor detected, sealing ${SQUASHFS}"

# --- preconditions -----------------------------------------------------------
if ! command -v veritysetup >/dev/null 2>&1; then
    echo "E: dm-verity(iso): veritysetup not found on the build host"
    echo "E: dm-verity(iso): add cryptsetup-bin to the aarch64 build container image"
    exit 1
fi
[ -f "${SQUASHFS}" ] || { echo "E: dm-verity(iso): ${SQUASHFS} not found"; exit 1; }
[ -f "${INITRD}" ]   || { echo "E: dm-verity(iso): ${INITRD} not found"; exit 1; }

# --- 1. pad the squashfs to a block boundary, then append the hash tree ------
# Formatting into a SEPARATE hash file and concatenating it avoids any
# "data and hash device are the same" refusal, and needs no --data-blocks math:
# the padded squashfs is the whole data device, and its size is the hash offset.
DATA_BYTES=$(stat -c %s "${SQUASHFS}")
HASH_OFFSET=$(( ( (DATA_BYTES + BS - 1) / BS ) * BS ))
if [ "${HASH_OFFSET}" -ne "${DATA_BYTES}" ]; then
    truncate -s "${HASH_OFFSET}" "${SQUASHFS}"   # grow with zeros to a ${BS} boundary
fi
echo "I: dm-verity(iso): data ${DATA_BYTES}B -> padded ${HASH_OFFSET}B (hash offset)"

HASHTMP=$(mktemp)
FMT_OUT=$(veritysetup format "${SQUASHFS}" "${HASHTMP}" \
    --data-block-size="${BS}" --hash-block-size="${BS}")
echo "${FMT_OUT}"

ROOT_HASH=$(echo "${FMT_OUT}" | awk '/Root hash:/ { print $NF }')

# Validate: exactly 64 lower/upper hex chars (sha256).
if [ "$(printf '%s' "${ROOT_HASH}" | wc -c)" -ne 64 ] || \
   printf '%s' "${ROOT_HASH}" | grep -q '[^0-9a-fA-F]'; then
    rm -f "${HASHTMP}"
    echo "E: dm-verity(iso): could not parse a 64-hex root hash (got '${ROOT_HASH}')"
    exit 1
fi

cat "${HASHTMP}" >> "${SQUASHFS}"
rm -f "${HASHTMP}"
echo "I: dm-verity(iso): root hash ${ROOT_HASH}"

# --- 2. bake the root hash + geometry into the live initramfs ----------------
# The kernel overlays extra initramfs content by concatenating cpio segments,
# but it only extracts a following segment when that segment starts on a 4-byte
# boundary. The base initrd is a single zstd stream of arbitrary length, so we
# MUST zero-pad it to a 4-byte boundary BEFORE appending the gzip params cpio;
# otherwise the append lands mid-word, the kernel silently drops it, and
# /etc/verity/params never appears at boot. The init-premount hook then
# self-gates OFF and a sealed verity image boots UNVERIFIED. Observed in the
# field: an installed verity image whose params segment sat at an odd offset
# booted with no /dev/mapper/verity-root and no panic.
STAGE=$(mktemp -d)
mkdir -p "${STAGE}/etc/verity"
cat > "${STAGE}/etc/verity/params" <<EOF
# Generated by 28-igos-dm-verity.binary; consumed by the init-premount hook
# igos-verity-root. The mere presence of this file self-gates verity at boot.
VERITY_ROOT_HASH=${ROOT_HASH}
VERITY_HASH_OFFSET=${HASH_OFFSET}
VERITY_DATA_BLOCK_SIZE=${BS}
VERITY_HASH_BLOCK_SIZE=${BS}
VERITY_MAPPER_NAME=${VERITY_NAME}
VERITY_SQUASHFS_NAME=${SQUASHFS_NAME}
EOF

# Zero-pad the initrd to a 4-byte boundary so the appended cpio is aligned.
INITRD_BYTES=$(stat -c %s "${INITRD}")
PAD=$(( (4 - (INITRD_BYTES % 4)) % 4 ))
if [ "${PAD}" -ne 0 ]; then
    dd if=/dev/zero bs=1 count="${PAD}" >> "${INITRD}" 2>/dev/null
fi
APPEND_OFFSET=$(stat -c %s "${INITRD}")   # 4-byte aligned: where the gzip starts

( cd "${STAGE}" && find . | cpio --quiet -o -H newc ) | gzip -9 >> "${INITRD}"
rm -rf "${STAGE}"
echo "I: dm-verity(iso): appended params cpio at ${APPEND_OFFSET} (+${PAD}B pad)"

# --- 3. fail-closed BUILD check: params MUST be re-extractable ----------------
# If the appended segment cannot be recovered, the image would boot unverified.
# Carve from the known aligned offset and require etc/verity/params; otherwise
# fail the build so an unverifiable "verity" image can never ship.
if ! dd if="${INITRD}" bs=1 skip="${APPEND_OFFSET}" 2>/dev/null \
        | gzip -dc 2>/dev/null | cpio -t 2>/dev/null \
        | grep -q 'etc/verity/params'; then
    echo "E: dm-verity(iso): /etc/verity/params not re-extractable from ${INITRD}"
    echo "E: dm-verity(iso): refusing to ship a verity image that would boot unverified"
    exit 1
fi

echo "I: dm-verity(iso): baked + verified /etc/verity/params in ${INITRD}"
echo "I: dm-verity(iso): done"
