+static int tsigscan_handler(struct uart_port *port,unsigned long arg)
+{
+	struct uart_8250_port *up = up_to_u8250p(port);
+	// struct mctrl_gpios *gpios = up->gpios;
+	struct sigscan sigCopy;
+	int returnCode = 0;
+
+	do
+	{
+		if(copy_from_user(&sigCopy, (struct sigscan *)arg, sizeof(struct sigscan)))
+		{
+			returnCode = -EFAULT;
+			break;
+		}
+
+		// incase other CPU runs during timer_delete_sync() we must be unlocked...
+		perle_fsmSigScan(up, FSMSS_EXIT, 0, 2);
+
+		scoped_guard(uart_port_lock_irq, &up->port)
+		{
+			if(sigCopy.pid != 0 && sigCopy.sigmask != 0)
+			{
+				memcpy(&up->sigScan, &sigCopy, sizeof(struct sigscan));
+				perle_fsmSigScan(up, FSMSS_SCAN, 0, 3);
+				perle_fsmSigScan(up, FSMSS_TIOCM, up->mctrl_prev, 4);
+				//perle_fsmSigScan(up, FSMSS_TIOCM, MSR2TIOCM((unsigned char)up->last_msr_read),4);
+				//perle_fsmSigScan(up, FSMSS_TIOCM, (unsigned char)up->last_msr_read,4);
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("%s,%d: mctrl_prev %x \n", __func__, __LINE__, up->mctrl_prev);
+#endif
+			}
+			// else if(sigCopy.sigdrop)	// allow drop only function
+			// {
+			//	 returnCode=perle_set_modem_info(up, TIOCMBIC, sigCopy.sigdrop);
+			// }
+		}
+	}while(0);
+
+	return(returnCode);
+}
