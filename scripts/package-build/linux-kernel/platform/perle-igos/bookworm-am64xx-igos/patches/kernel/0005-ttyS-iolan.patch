+#include <linux/tty_flip.h>
+#include "8250.h"
+#include "8250_perle.h"
+#include "linux/uart_trace.h"
+
+perle_ioctl_t perle_ioctl[] = {
+	{TCGETS,        "TCGETS"},
+	{TCSETS,        "TCSETS"},
+	{TCSETSW,       "TCSETSW"},
+	{TCFLSH,        "TCFLSH"},
+	{TIOCGRS485,    "TIOCGRS485"},
+	{TIOCSRS485,    "TIOCSRS485"},
+	{TRPTSET,       "TRPTSET"},
+	{TRPTGET,       "TRPTGET"},
+	{TRPTGETRST,    "TRPTGETRST"},
+	{TRPTSETPID,    "TRPTSETPID"},
+	{TIOCSERDS,     "TIOCSERDS"},
+	{TIOCFWDDS,     "TIOCFWDDS"},
+	{TIOCMAPDTR,    "TIOCMAPDTR"},
+	{TIOCMAPRTS,    "TIOCMAPRTS"},
+	{TRACECONTROL,  "TRACECONTROL"},
+	{TRACEREAD,     "TRACEREAD"},
+	{TIOCOSARMDS,   "TIOCOSARMDS"},
+	{TRESETCOUNT,   "TRESETCOUNT"},
+	{TSIGSCAN,      "TSIGSCAN"},
+	{TIOCCICOUNT,   "TIOCCICOUNT"},
+	{TRTSCONTROL,   "TRTSCONTROL"},
+	{TCSETS2,       "TCSETS2"},
+	{TIOCSLEEP,     "TIOCSLEEP"},
+	{0x5600,        "VT_OPENQRY"},
+	{0,""},
+};
+
+extern char procSigScan[];	// one for each port
+int perle_getProcSigScan(int dsline)
+{
+	if(dsline >= 0 && dsline < 256)
+	{
+		return(procSigScan[dsline]);
+	}
+	return(-1);
+}
+EXPORT_SYMBOL_GPL(perle_getProcSigScan);
+
+int perle_setProcSigScan(int dsline, int state)
+{
+	if(dsline >= 0 && dsline < 256)
+	{
+		procSigScan[dsline] = (unsigned char)state;
+		return(state);
+	}
+	return(-1);
+}
+EXPORT_SYMBOL_GPL(perle_setProcSigScan);
+
+static void push_char(struct uart_8250_port *up, unsigned int lsrStatus, unsigned int overrun, unsigned char ch, unsigned char st);
+static void push_char_frame(struct uart_8250_port *up, unsigned char ch, unsigned char st);
+static void push_char_end(struct uart_8250_port *up, unsigned char ch, unsigned char st);
+static void store_char(struct uart_8250_port *up, unsigned char ch, unsigned char st);
+static void fix_port_mctrl_from_mcr(struct uart_8250_port *up);
+static void forward_frame(struct uart_8250_port *up);
+
+int perle_set_modem_info(struct uart_8250_port *up, unsigned int cmd, unsigned int arg)
+{
+	unsigned char or, xor, mask=0, outs;
+#ifdef PERLE_SERIAL_DEBUG
+	printk_deferred("perle_set_modem_info: cmd=0x%x arg=0x%x rts_toggle=%d\n", cmd, arg, up->rs232_rts_toggle);
+	printk_deferred("%s()@%d: arg %x\n", __FUNCTION__, __LINE__, arg);
+#endif
+	or = xor = 0;
+	if ((arg & TIOCM_RTS) && !(up->rs232_rts_toggle))
+		or |= UART_MCR_RTS;
+	if (arg & TIOCM_DTR)
+		or |= UART_MCR_DTR;
+	if (arg & TIOCM_OUT1)
+		or |= UART_MCR_OUT1;
+	if (arg & TIOCM_OUT2)
+		or |= UART_MCR_OUT2;
+	if (arg & TIOCM_LOOP)
+		or |= UART_MCR_LOOP;
+
+	switch (cmd)
+	{
+		case TIOCMBIS:
+			break;
+		case TIOCMBIC:
+			xor = or;
+			break;
+		case TIOCMSET:
+			mask = (UART_MCR_RTS|UART_MCR_DTR|UART_MCR_OUT1|UART_MCR_OUT2|UART_MCR_LOOP);
+			xor = ~or & mask;
+			or = mask;
+			break;
+		case TIOCMAPDTR:
+			mask = UART_MCR_DTR;
+			break;
+		case TIOCMAPRTS:
+			mask = UART_MCR_RTS;
+			break;
+	}
+#ifdef PERLE_SERIAL_DEBUG
+	printk_deferred("%s()@%d: or %x xor %x mask %x\n", __FUNCTION__, __LINE__, or, xor, mask);
+#endif
+	switch (cmd)
+	{
+		case TIOCMAPDTR:
+		case TIOCMAPRTS:
+			outs = up->out1|up->out2;
+			// if unmapping signal restore value
+			if((outs & mask) && !(or & (UART_MCR_OUT1|UART_MCR_OUT2)))
+				up->mcr = (up->mcr & ~mask) | (up->MCRmap & mask);
+			if(or & UART_MCR_OUT1)
+				up->out1 |= mask;
+			else
+				up->out1 &= ~mask;
+			if(or & UART_MCR_OUT2)
+				up->out2 |= mask;
+			else
+				up->out2 &= ~mask;
+			or = xor = 0;
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("%s()@%d: mcr %x out1 %x out2 %x\n", __FUNCTION__, __LINE__, up->mcr, up->out1, up->out2);
+#endif
+			break;
+		case TIOCMSET:
+		case TIOCMBIS:
+		case TIOCMBIC:
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("%s()@%d: before MCRmap %x\n", __FUNCTION__, __LINE__, up->MCRmap);
+#endif
+			up->MCRmap = (up->MCRmap | or) ^ xor;   // save new MCR pattern
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("%s()@%d: after MCRmap %x\n", __FUNCTION__, __LINE__, up->MCRmap);
+#endif
+			break;
+	}
+
+	if(up->out1)								// re-map OUT1
+	{
+		or |= up->out1;
+		xor = (xor | up->out1) ^ (up->MCRmap & UART_MCR_OUT1 ? up->out1 : 0);
+#ifdef PERLE_SERIAL_DEBUG
+		printk_deferred("%s()@%d: out1 or %x xor %x\n", __FUNCTION__, __LINE__, or, xor);
+#endif
+	}
+	if(up->out2)								// re-map OUT2
+	{
+		or |= up->out2;
+		xor = (xor | up->out2) ^ (up->MCRmap & UART_MCR_OUT2 ? up->out2 : 0);
+#ifdef PERLE_SERIAL_DEBUG
+		printk_deferred("%s()@%d: out2 or %x xor %x\n", __FUNCTION__, __LINE__, or, xor);
+#endif
+	}
+
+	{
+		u8  new_mcr;
+
+		or &= ~(UART_MCR_OUT1|UART_MCR_OUT2);
+		xor &= ~(UART_MCR_OUT1|UART_MCR_OUT2);
+		new_mcr = (up->last_mcr_written | or) ^ xor;
+#ifdef PERLE_SERIAL_DEBUG
+		printk_deferred("%s()@%d: or %x xor %x new_mcr %x\n", __FUNCTION__, __LINE__, or, xor, new_mcr);
+#endif
+		new_mcr = (new_mcr & up->mcr_mask) | up->mcr_force | up->mcr;   // copied from serial8250_do_set_mctrl
+#ifdef PERLE_SERIAL_DEBUG
+		printk_deferred("%s()@%d: new_mcr %x mcr_mask %x force %x mcr %x\n", __FUNCTION__, __LINE__, new_mcr, up->mcr_mask, up->mcr_force, up->mcr);
+#endif
+		serial8250_out_MCR(up, new_mcr);
+		// perle_serial_out_mcr(up, new_mcr);
+	}
+	return 0;
+}
+
+void perle_serial_out_mcr(struct uart_8250_port *up, int value)
+{
+	serial_out(up, UART_MCR, value);
+	up->last_mcr_written=value;
+	fix_port_mctrl_from_mcr(up);
+	if(up->traceMask & TRACE_BITS_SIGNALS)
+	{
+		int last_msr = up->last_msr_read;
+		uartTraceAddSignals(up->tracePortIndex, &up->traceSignals, value, last_msr);
+	}
+}
+EXPORT_SYMBOL_GPL(perle_serial_out_mcr);
+
+void perle_serial8250_out_MCR_pre(struct uart_8250_port *up, int *value)
+{
+#ifdef PERLE_SERIAL_DEBUG
+	int orig_value = *value;
+#endif
+	if (up->port.rs485.flags & SER_RS422_ENABLED)
+	{
+		*value &= ~UART_MCR_RTS;  /* RS422: clear MCR bit to keep RTS signal LOW */
+		*value &= ~UART_MCR_DTR;  /* RS422: keep DTR LOW */
+	}
+	else if (up->port.rs485.flags & SER_RS485_ENABLED)
+	{
+		*value &= ~UART_MCR_DTR;  /* RS485: keep DTR LOW */
+	}
+#ifdef PERLE_SERIAL_DEBUG
+	if (*value != orig_value)
+		printk_deferred("perle_out_MCR_pre: flags=0x%x orig=0x%x new=0x%x\n",
+			up->port.rs485.flags, orig_value, *value);
+#endif
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_out_MCR_pre);
+
+void perle_serial8250_out_MCR_post(struct uart_8250_port *up, int value)
+{
+	up->last_mcr_written = value;
+	fix_port_mctrl_from_mcr(up);
+	if (up->traceMask & TRACE_BITS_SIGNALS)
+	{
+		uartTraceAddSignals(up->tracePortIndex, &up->traceSignals, value, up->last_msr_read);
+	}
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_out_MCR_post);
+
+int perle_serial_in_msr(struct uart_8250_port *up)
+{
+	int value;
+
+	value = serial_in(up, UART_MSR);
+	if (value & UART_MSR_CTS)
+		up->last_msr_read |= UART_MSR_CTS;
+	else
+		up->last_msr_read &= ~UART_MSR_CTS;
+
+	int sig_gpios = 0;
+	if (up->gpios)
+	{
+		mctrl_gpio_get(up->gpios, &sig_gpios);
+
+		if (sig_gpios & TIOCM_DSR)
+			up->last_msr_read |= UART_MSR_DSR;
+		else
+			up->last_msr_read &= ~UART_MSR_DSR;
+
+		if (sig_gpios & TIOCM_CAR)
+			up->last_msr_read |= UART_MSR_DCD;
+		else
+			up->last_msr_read &= ~UART_MSR_DCD;
+
+		if (sig_gpios & TIOCM_RI)
+			up->last_msr_read |= UART_MSR_RI;
+		else
+			up->last_msr_read &= ~UART_MSR_RI;
+	}
+	
+	if(up->traceMask & TRACE_BITS_SIGNALS)
+	{
+		uartTraceAddSignals(up->tracePortIndex, &up->traceSignals, up->last_mcr_written, up->last_msr_read);
+	}
+	return(value);
+}
+EXPORT_SYMBOL_GPL(perle_serial_in_msr);
+
+void perle_serial8250_flush_rx(struct uart_8250_port *up)
+{
+	serial_out(up, UART_FCR, up->fcr|UART_FCR_CLEAR_RCVR);
+}
+
+/*
+ * ===============================================
+ * rtscontrol routines
+ * ===============================================
+ */
+static unsigned int serial_in_UART_TXCNT(struct uart_8250_port *up)
+{
+	int i;
+	int count1 = -1;
+	int count2 = -1;
+
+	count1 = serial_in(up, UART_EXAR_TXCNT);
+	for (i = 0; i < 16; i++)
+	{
+		count2 = serial_in(up, UART_EXAR_TXCNT);
+		if (count1 == count2)
+			break;
+
+		count1 = count2;
+	}
+	return(count1);
+}
+
+/*
+ * rs232 rts toggle timeout
+ */
+void perle_serial8250_rs232_rts_toggle_timer(struct timer_list *t)
+{
+	int status;
+	int rts_toggle_delay;
+	struct uart_8250_port *up = timer_container_of(up, t, rs232_rts_toggle_timer);
+	struct uart_port *port = &up->port;	// SVT
+	int tmp_mcr;
+
+	tmp_mcr = serial_in(up, UART_MCR);
+
+	if (!(tmp_mcr & UART_MCR_RTS))
+	{
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		printk_deferred("ps_rs232_rts_toggle_timer: RTS already down\n");
+#endif
+		return;
+	}
+	status = serial_in(up, UART_LSR);
+	up->lsr_saved_flags |= status & LSR_SAVE_FLAGS;
+
+	if (status & UART_LSR_TEMT)
+	{
+		scoped_guard(uart_port_lock_irq, port)
+		{
+			tmp_mcr &= ~UART_MCR_RTS;
+			perle_serial_out_mcr(up, tmp_mcr);
+		}
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		printk_deferred("ps_rs232_rts_toggle_timer: TEMT empty, set RTS down\n");
+#endif
+	}
+	else
+	{
+		rts_toggle_delay = serial_in_UART_TXCNT(up);
+		if (rts_toggle_delay == 0)
+			rts_toggle_delay = 1;
+		
+		rts_toggle_delay *= up->rs232_rts_toggle_char_timeout * HZ / 1000;
+		mod_timer(&up->rs232_rts_toggle_timer, jiffies + rts_toggle_delay);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		printk_deferred("perle_rts_toggle_timer: TX not empty (LSR=0x%x), rescheduling delay=%d\n", status, rts_toggle_delay);
+		printk_deferred("ps_rs232_rts_toggle_timer: set rs232_rts_toggle_timer, %d\n",rts_toggle_delay);
+#endif
+	}
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_rs232_rts_toggle_timer);
+
+/*
+ * rs232 rts toggle initial timeout
+ */
+void perle_serial8250_rs232_rts_toggle_initial_timer(struct timer_list *t)
+{
+	struct uart_8250_port *up = timer_container_of(up, t, rs232_rts_toggle_initial_timer);
+
+	serial8250_rpm_get_tx(up);
+
+	scoped_guard(uart_port_lock_irq, &up->port)
+	{
+		up->ier |= UART_IER_THRI;
+		serial_out(up, UART_IER, up->ier);
+
+		perle_serial8250_tx_chars(up);
+	}
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_rs232_rts_toggle_initial_timer);
