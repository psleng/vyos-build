index 000000000000..ceeb58cad0c1
--- /dev/null
+++ b/arch/arm64/boot/dts/perle/k3-am642-igos.dtsi
@@ -0,0 +1,805 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Copyright (C) 2020-2024 Texas Instruments Incorporated - https://www.ti.com/
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/net/ti-dp83867.h>
+#include "k3-am642.dtsi"
+
+#include "k3-serdes.h"
+
+/ {
+	cpufreq {
+		compatible = "ti,am64-cpufreq";
+	};
+
+	device-info {
+		compatible = "perle,device-info";
+		nvmem-cells = <&serial>, <&product>, <&model>;
+		nvmem-cell-names = "serial", "product", "model";
+	};
+
+	memory@80000000 {
+		bootph-all;
+		device_type = "memory";
+		/* 2G RAM */
+		reg = <0x00000000 0x80000000 0x00000000 0x80000000>;
+	};
+
+	reserved_memory: reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		secure_ddr: optee@9e800000 {
+			reg = <0x00 0x9e800000 0x00 0x01800000>; /* for OP-TEE */
+			alignment = <0x1000>;
+			no-map;
+		};
+
+		main_r5fss0_core0_dma_memory_region: memory@a0000000 {
+			compatible = "shared-dma-pool";
+			reg = <0x00 0xa0000000 0x00 0x100000>;
+			no-map;
+		};
+
+		main_r5fss0_core0_memory_region: memory@a0100000 {
+			compatible = "shared-dma-pool";
+			reg = <0x00 0xa0100000 0x00 0xf00000>;
+			no-map;
+		};
+	};
+
+	/* Module Power Supply */
+	reg_vsodimm: regulator-vsodimm {
+		compatible = "regulator-fixed";
+		regulator-name = "+V_SODIMM";
+	};
+
+	/* Non PMIC On-module Supplies */
+	reg_3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-max-microvolt = <3300000>;
+		regulator-min-microvolt = <3300000>;
+		regulator-name = "On-module +V3.3";
+		vin-supply = <&reg_vsodimm>;
+	};
+
+	a53_opp_table: opp-table {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			/* opp-supported-hw = <0x01 0x00>; */
+			clock-latency-ns = <600000>;
+		};
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+			/* opp-supported-hw = <0x01 0x00>; */
+			clock-latency-ns = <600000>;
+		};
+	};
+
+	firmware {
+		optee {
+			compatible = "linaro,optee-tz";
+			method = "smc";
+		};
+	};
+
+	tpm@0 {
+		name = "tpm";
+		status = "okay";
+		compatible = "microsoft,ftpm";
+		uuid = /bits/ 8 <0xbc 0x50 0xd9 0x71 0xd4 0xc9 0x42 0xc4 0x82 0xcb 0x34 0x3f 0xb7 0xf3 0x78 0x96>;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		led-uart0-tx {
+			label = "uart0:tx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_TX;
+			gpios = <&main_gpio0 4 GPIO_ACTIVE_HIGH>;	/* OSPI0_D1 (M18) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart0>;
+		};
+		led-uart0-rx {
+			label = "uart0:rx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_RX;
+			gpios = <&main_gpio0 5 GPIO_ACTIVE_HIGH>;	/* OSPI0_D2 (M20) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart0>;
+		};
+		led-uart2-tx {
+			label = "uart2:tx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_TX;
+			gpios = <&main_gpio0 6 GPIO_ACTIVE_HIGH>;	/* OSPI0_D3 (M21) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart2>;
+		};
+		led-uart2-rx {
+			label = "uart2:rx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_RX;
+			gpios = <&main_gpio0 7 GPIO_ACTIVE_HIGH>;	/* OSPI0_D4 (P21) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart2>;
+		};
+		led-uart4-tx {
+			label = "uart4:tx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_TX;
+			gpios = <&main_gpio0 8 GPIO_ACTIVE_HIGH>;	/* OSPI0_D5 (P20) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart4>;
+		};
+		led-uart4-rx {
+			label = "uart4:rx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_RX;
+			gpios = <&main_gpio0 9 GPIO_ACTIVE_HIGH>;	/* OSPI0_D6 (N18) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart4>;
+		};
+		led-uart5-tx {
+			label = "uart5:tx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_TX;
+			gpios = <&main_gpio0 12 GPIO_ACTIVE_HIGH>;	/* OSIP0_CSn1 (L18) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart5>;
+		};
+		led-uart5-rx {
+			label = "uart5:rx";
+			color = <LED_COLOR_ID_YELLOW>;
+			function = LED_FUNCTION_RX;
+			gpios = <&main_gpio0 13 GPIO_ACTIVE_HIGH>;	/* OSPI0_CSn2 (K17) */
+			default-state = "off";
+			linux,default-trigger = "tty";
+			trigger-sources = <&main_uart5>;
+		};
+	};
+};
+
+&main_pmx0 {
+	main_uart0_pins_default: main-uart0-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x0230, PIN_INPUT_PULLUP, 0)    /* (D15) UART0_RXD */
+			AM64X_IOPAD(0x0234, PIN_OUTPUT, 0)          /* (C16) UART0_TXD */
+			AM64X_IOPAD(0x0238, PIN_INPUT_PULLUP, 0)    /* (B16) UART0_CTSn */
+			AM64X_IOPAD(0x023c, PIN_OUTPUT, 0)          /* (A16) UART0_RTSn */
+		>;
+	};
+
+	main_uart2_pins_default: main-uart2-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x027c, PIN_INPUT_PULLUP, 3)    /* (K18) MMC1_DAT3.UART2_RXD */
+			AM64X_IOPAD(0x0280, PIN_OUTPUT, 3)          /* (K19) MMC1_DAT2.UART2_TXD */
+			AM64X_IOPAD(0x028c, PIN_INPUT_PULLUP, 1)    /* (L20) MMC1_CLK.UART2_CTSn */
+			AM64X_IOPAD(0x0294, PIN_OUTPUT, 1)          /* (J19) MMC1_CMD.UART2_RTSn */
+		>;
+	};
+
+	main_uart3_pins_default: main-uart3-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+ 			AM64X_IOPAD(0x0188, PIN_INPUT_PULLUP, 10)   /* (AA5) UART3_RXD */
+ 			AM64X_IOPAD(0x0170, PIN_OUTPUT, 10)         /* (AA2) UART3_TXD */
+		>;
+	};
+
+	main_uart4_pins_default: main-uart4-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x01dc, PIN_INPUT_PULLUP, 10)   /* (W4) PRG0_PRU1_GPO11.UART4_RXD */
+			AM64X_IOPAD(0x01cc, PIN_OUTPUT, 10)         /* (W5) PRG0_PRU1_GPO7.UART4_TXD */
+			AM64X_IOPAD(0x0178, PIN_INPUT_PULLUP, 10)   /* (T3) PRG0_PRU0_GPO6.UART4_CTSn */
+			AM64X_IOPAD(0x0180, PIN_OUTPUT, 10)         /* (T2) PRG0_PRU0_GPO8.UART4_RTSn */
+		>;
+	};
+
+	main_uart5_pins_default: main-uart5-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x01d4, PIN_INPUT_PULLUP, 10)   /* (Y5) PRG0_PRU1_GPO9.UART5_RXD */
+			AM64X_IOPAD(0x01b4, PIN_OUTPUT, 10)         /* (W2) PRG0_PRU1_GPO1.UART5_TXD */
+			AM64X_IOPAD(0x01b0, PIN_INPUT_PULLUP, 10)   /* (Y2) PRG0_PRU1_GPO0.UART5_CTSn */
+			AM64X_IOPAD(0x01b8, PIN_OUTPUT, 10)         /* (V3) PRG0_PRU1_GPO2.UART5_RTSn */
+		>;
+	};
+
+	main_uart6_pins_default: main-uart6-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x01e8, PIN_INPUT_PULLUP, 10)   /* (U6) PRG0_PRU1_GPO14.UART6_RXD */
+			AM64X_IOPAD(0x01c0, PIN_OUTPUT, 10)         /* (W3) PRG0_PRU1_GPO4.UART6_TXD */
+			AM64X_IOPAD(0x01bc, PIN_INPUT_PULLUP, 10)   /* (T4) PRG0_PRU1_GPO3.UART6_CTSn */
+			AM64X_IOPAD(0x01c4, PIN_OUTPUT, 10)         /* (P4) PRG0_PRU1_GPO5.UART6_RTSn */
+		>;
+	};
+
+	main_i2c0_pins_default: main-i2c0-default-pins {
+		bootph-all;
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x0260, PIN_INPUT_PULLUP, 0)    /* (A18) I2C0_SCL */
+			AM64X_IOPAD(0x0264, PIN_INPUT_PULLUP, 0)    /* (B18) I2C0_SDA */
+		>;
+	};
+
+	/* Digital IOs */
+	main_gpio0_digital_pins: main-gpio0-digital-pins {
+		pinctrl-single,pins = <
+			AM64X_IOPAD(0x0010, PIN_OUTPUT_PULLDOWN,7) /* (M18) OSPI0_D1         => GPIO0_4  (UARTLED0.TX)               */
+			AM64X_IOPAD(0x0014, PIN_OUTPUT_PULLDOWN,7) /* (M20) OSPI0_D2         => GPIO0_5  (UARTLED0.RX)               */
+			AM64X_IOPAD(0x0018, PIN_OUTPUT_PULLDOWN,7) /* (M21) OSPI0_D3         => GPIO0_6  (UARTLED2.TX)               */
+			AM64X_IOPAD(0x001C, PIN_OUTPUT_PULLDOWN,7) /* (P21) OSPI0_D4         => GPIO0_7  (UARTLED2.RX)               */
+			AM64X_IOPAD(0x0020, PIN_OUTPUT_PULLDOWN,7) /* (P20) OSPI0_D5         => GPIO0_8  (UARTLED4.TX)               */
+			AM64X_IOPAD(0x0024, PIN_OUTPUT_PULLDOWN,7) /* (N18) OSPI0_D6         => GPIO0_9  (UARTLED4.RX)               */
+			AM64X_IOPAD(0x0030, PIN_OUTPUT_PULLDOWN,7) /* (L18) OSIP0_CSn1       => GPIO0_12 (UARTLED5.TX)               */
+			AM64X_IOPAD(0x0034, PIN_OUTPUT_PULLDOWN,7) /* (K17) OSPI0_CSn2       => GPIO0_13 (UARTLED5.RX)               */
+			AM64X_IOPAD(0x00A4, PIN_INPUT_PULLUP,   7) /* (N17) GPMC0_DIR        => GPIO0_40 (UARTC2.MODE0)              */
+			AM64X_IOPAD(0x00B4, PIN_INPUT_PULLUP,   7) /* (R21) GPMC0_CSn3       => GPIO0_44 (UARTC2.MODE1)              */
+			AM64X_IOPAD(0x0084, PIN_INPUT_PULLUP,   7) /* (P16) GPMC0_ADVn_ALE   => GPIO0_32 (UARTC2.MODE2)              */
+			AM64X_IOPAD(0x00A8, PIN_INPUT_PULLDOWN, 7) /* (R19) GPMC0_CSn0       => GPIO0_41 (UARTC2.TERM_TX)            */
+			AM64X_IOPAD(0x00AC, PIN_INPUT_PULLDOWN, 7) /* (R20) GPMC0_CSn1       => GPIO0_42 (UARTC2.TERM_RX)            */
+			AM64X_IOPAD(0x0090, PIN_INPUT_PULLUP,   7) /* (P17) GPMC0_BE0n_CLE   => GPIO0_35 (UARTC2.SLR)                */
+			AM64X_IOPAD(0x0094, PIN_INPUT_PULLDOWN, 7) /* (T19) GPMC0_BE1n       => GPIO0_36 (UARTC2.SHUT_N)             */
+			AM64X_IOPAD(0x00FC, PIN_INPUT_PULLUP,   7) /* (U7)  PRG1_PRU0_GPO17  => GPIO0_62 (STAT_SYS.RED)              */
+			AM64X_IOPAD(0x00BC, PIN_INPUT_PULLDOWN, 7) /* (U8)  PRG1_PRU0_GPO1   => GPIO0_46 (STAT_SYS.BLUE)             */
