+	struct uart_port *port = &up->port;
+
+	scoped_guard(uart_port_lock_irq, port)
+		perle_fsmSigScan(up, FSMSS_TIMEOUT, 0, 1);
+
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_sigscan_delay_timer);
