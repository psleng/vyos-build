# /etc/udev/rules.d/76-igos-modem-uid.rules
#
# Pin ModemManager UID to the physical USB slot, not the modem card.
# Must sort before ModemManager's own 77-mm-*.rules so MM sees the UID
# before it assigns its own.
#
# Topology for any AM64x igos board (locked to DTS addresses, not probe order):
#   f400000.usb     = xhci platform device (DTS reg address — stable)
#   devpath "1"     = controller root-hub port 1 (physical slot 1)
#   devpath "2"     = controller root-hub port 2 (physical slot 2, reserved)
#
# Why NOT xhci-hcd.4.auto / KERNEL=="1-1":
#   - ".4.auto" is the cdns3 driver's auto-probe index — can shift if any
#     earlier auto-probed platform device is added/removed.
#   - "1-1" leading "1" is the USB *bus* number, assigned at xhci registration
#     order — can shift if another xhci controller registers first.
#   - f400000.usb + ATTRS{devpath}=="1" is DTS- and topology-locked.
#
# Verify on hw:
#   udevadm info -a -p /sys/class/net/wwan0 | grep -E 'KERNELS|devpath'
#   udevadm info -q property /sys/bus/usb/devices/1-1 | grep ID_MM
#   mmcli -L
#   mmcli -m 0 --output-keyvalue | grep -iE 'uid|equipment'

# --- Slot 1 (root-hub port 1)  ->  modem0 ---------------------------------

# Parent usb_device — this is what MM keys off for ID_MM_PHYSDEV_UID
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", \
    KERNELS=="f400000.usb", ATTR{devpath}=="1", \
    ENV{ID_MM_PHYSDEV_UID}="modem0", \
    ENV{ID_MM_DEVICE_PROCESS}="1"

# cdc-wdm control node
ACTION=="add|change", SUBSYSTEM=="usbmisc", \
    KERNELS=="f400000.usb", ATTRS{devpath}=="1", \
    ENV{ID_MM_PHYSDEV_UID}="modem0"

# net interface (wwan0 / qmi_wwan)
ACTION=="add|change", SUBSYSTEM=="net", \
    KERNELS=="f400000.usb", ATTRS{devpath}=="1", \
    ENV{ID_MM_PHYSDEV_UID}="modem0"

# AT / diag tty ports
ACTION=="add|change", SUBSYSTEM=="tty", \
    KERNELS=="f400000.usb", ATTRS{devpath}=="1", \
    ENV{ID_MM_PHYSDEV_UID}="modem0"

