+int perle_serial8250_uart_trace_add_ioctl(struct uart_port *port, int ioctl_cmd)
+{
+	struct uart_8250_port *up = up_to_u8250p(port);
+
+#if defined DEBUG_PRINTK_IOCTL
+	debug_printk_ioctl(port,ioctl_cmd);
+#endif
+
+	if(up->traceMask & TRACE_BITS_IOCTL)
+	{
+		uartTraceAddIoctl(up->tracePortIndex, ioctl_cmd);
+	}
+	return(0);
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_uart_trace_add_ioctl);
