diff --git a/drivers/tty/serial/8250/8250_core.c b/drivers/tty/serial/8250/8250_core.c
index 18cf1a9757c8..fc7d8723a346 100644
--- a/drivers/tty/serial/8250/8250_core.c
+++ b/drivers/tty/serial/8250/8250_core.c
@@ -41,6 +41,7 @@
 #ifdef CONFIG_SPARC
 #include <linux/sunserialcore.h>
 #endif
+#include <linux/of.h>
 
 #include <asm/irq.h>
 
@@ -1285,6 +1286,40 @@ static int __init serial8250_init(void)
 {
 	int ret;
 
+	/* * PERLE SYSTEMS - IOLAN CUSTOMIZATION
+	 * --------------------------------------
+	 * Instead of using the static CONFIG_SERIAL_8250_NR_UARTS limit, we
+	 * dynamically count nodes in the Device Tree with status="okay".
+	 *
+	 * This ensures /dev/ttyS nodes strictly match the physical hardware
+	 * identified in the DT, preventing "ghost" ports (ttyS3-ttyS31) from
+	 * appearing in the OS.
+	 */
+	struct device_node *np;
+	int count = 0;
+
+	/* * Scan for all enabled UART nodes compatible with 8250/OMAP.
+	 * of_device_is_available() specifically checks for status="okay".
+	 */
+	for_each_node_with_property(np, "compatible") {
+		if (of_device_is_available(np)) {
+			if (of_device_is_compatible(np, "ti,am64-uart")) {
+				count++;
+			}
+		}
+	}
+
+	/* Update the local static variable */
+	if (count > 0) {
+		nr_uarts = count;
+		pr_info("8250_core: Auto-detected %d enabled UARTs in Device Tree\n", nr_uarts);
+	}
+
+	/* Standard kernel logic continues... */
+	if (nr_uarts > UART_NR)
+		nr_uarts = UART_NR;
+	/* PERLE SYSTEMS - IOLAN CUSTOMIZATION END */
+
 	if (nr_uarts == 0)
 		return -ENODEV;
 
