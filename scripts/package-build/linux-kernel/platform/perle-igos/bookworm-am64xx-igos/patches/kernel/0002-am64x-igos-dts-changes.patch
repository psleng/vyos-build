diff --git a/arch/arm64/boot/dts/perle/Makefile b/arch/arm64/boot/dts/perle/Makefile
new file mode 100644
index 000000000000..161fd26e95ae
--- /dev/null
+++ b/arch/arm64/boot/dts/perle/Makefile
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0-only
+#
+# Make file to build device tree binaries for boards based on
+# Texas Instruments Inc processors
+#
+# Copyright (C) 2016-2021 Texas Instruments Incorporated - https://www.ti.com/
+#
+# Entries are grouped as per SoC present on the board. Groups are sorted
+# alphabetically.
+
+# Boards with AM64x SoC
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-igos-1000.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-1000.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2A00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2B00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2C00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2D00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2E00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-2F00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-3000.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IOLAN-4000.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IRG-1000.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IRG-1A00.dtb
+dtb-$(CONFIG_TARGET_AM6412_IOLAN) += k3-am642-IRG-4000.dtb
+
+# Enable support for device-tree overlays
+DTC_FLAGS := -@
diff --git a/arch/arm64/boot/dts/perle/k3-am642-IOLAN-1000.dts b/arch/arm64/boot/dts/perle/k3-am642-IOLAN-1000.dts
new file mode 100644
index 000000000000..2034885d0f2c
--- /dev/null
+++ b/arch/arm64/boot/dts/perle/k3-am642-IOLAN-1000.dts
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Copyright (C) 2020-2024 Texas Instruments Incorporated - https://www.ti.com/
+ */
+
+/dts-v1/;
+
+#include "k3-am642-igos.dtsi"
+
+/ {
+	compatible = "perle,am6412-iolan", "ti,am642";
+	model = "Perle AM6412 IOLAN-1000";
+
+	chosen {
+		stdout-path = &main_uart3;
+	};
+
+	aliases {
+		serial0 = &main_uart3;
+		serial1 = &main_uart0;
+		serial2 = &main_uart2;
+		serial3 = &main_uart4;
+		serial4 = &main_uart5;
+		serial5 = &main_uart6;
+		i2c0 = &main_i2c0;
+		mmc0 = &sdhci0;
+		ethernet0 = &cpsw_port2;
+		rtc0 = &rtc_rv3028;
+	};
+};
+
+&main_uart0 {
+	status = "okay";
+};
+
+&main_i2c0 {
+	status = "okay";
+};
+
+&main_i2c1 {
+    status = "disabled";
+};
+
+&main_gpio0 {
+	status = "okay";
+};
+
+&main_gpio1 {
+	status = "okay";
+};
+
+/* eMMC */
+&sdhci0 {
+	status = "okay";
+};
+
+/* SD/MMC */
+&sdhci1 {
+    status = "disabled";
+};
+
+&cpsw_port1 {
+	status = "disabled";
+};
+
+&cpsw_port2 {
+	status = "okay";
+};
\ No newline at end of file
