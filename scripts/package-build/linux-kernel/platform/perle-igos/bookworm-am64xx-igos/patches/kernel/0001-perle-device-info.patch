index 000000000..2b2d45d46
--- /dev/null
+++ b/drivers/platform/perle/device-info.c
@@ -0,0 +1,181 @@
+/*
+ * Perle device information driver
+ *
+ * Exposes NVMEM cells as read-only binary sysfs attributes.
+ */
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+
+struct perle_device_info_attr {
+	struct bin_attribute bin_attr;
+	struct nvmem_cell *cell;
+	bool bytes;
+};
+
+struct perle_device_info {
+	struct perle_device_info_attr *cell_attrs;
+	const struct bin_attribute **bin_attrs;
+	struct attribute_group group;
+};
+
+static ssize_t perle_device_info_read(struct file *filp, struct kobject *kobj,
+				      const struct bin_attribute *bin_attr,
+				      char *buf, loff_t pos, size_t count)
+{
+	struct perle_device_info_attr *device_attr;
+	size_t len;
+	size_t output_len;
+	char *data;
+	ssize_t ret;
+
+	device_attr = container_of(bin_attr, struct perle_device_info_attr,
+				   bin_attr);
+
+	data = nvmem_cell_read(device_attr->cell, &len);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+
+	if (device_attr->bytes) {
+		output_len = len;
+	} else {
+		while (len && (data[len - 1] == '\0' ||
+			       (unsigned char)data[len - 1] == 0xff))
+			len--;
+
+		output_len = strnlen(data, len);
+	}
+
+	if (pos >= output_len) {
+		ret = 0;
+	} else {
+		ret = min_t(size_t, count, output_len - pos);
+		memcpy(buf, data + pos, ret);
+	}
+
+	kfree(data);
+
+	return ret;
+}
+
+static bool perle_device_info_name_valid(const char *name)
+{
+	if (!name[0] || strchr(name, '/'))
+		return false;
+
+	return strcmp(name, ".") && strcmp(name, "..");
+}
+
+static int perle_device_info_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct perle_device_info_attr *device_attr;
+	struct perle_device_info *info;
+	struct device_node *cell_np;
+	const char **names;
+	int count;
+	int index;
+	int previous;
+	int ret;
+
+	count = device_property_string_array_count(dev, "nvmem-cell-names");
+	if (count <= 0)
+		return dev_err_probe(dev, count < 0 ? count : -EINVAL,
+				     "no NVMEM cell names defined\n");
+
+	info = devm_kzalloc(dev, sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+
+	info->cell_attrs = devm_kcalloc(dev, count,
+				       sizeof(*info->cell_attrs), GFP_KERNEL);
+	if (!info->cell_attrs)
+		return -ENOMEM;
+
+	info->bin_attrs = devm_kcalloc(dev, count + 1,
+				      sizeof(*info->bin_attrs), GFP_KERNEL);
+	if (!info->bin_attrs)
+		return -ENOMEM;
+
+	names = devm_kcalloc(dev, count, sizeof(*names), GFP_KERNEL);
+	if (!names)
+		return -ENOMEM;
+
+	ret = device_property_read_string_array(dev, "nvmem-cell-names",
+						names, count);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "failed to read NVMEM cell names\n");
+	for (index = 0; index < count; index++) {
+		if (!perle_device_info_name_valid(names[index]))
+			return dev_err_probe(dev, -EINVAL,
+					     "invalid sysfs name \"%s\"\n",
+					     names[index]);
+
+		for (previous = 0; previous < index; previous++) {
+			if (!strcmp(names[index], names[previous]))
+				return dev_err_probe(dev, -EINVAL,
+						     "duplicate NVMEM cell name \"%s\"\n",
+						     names[index]);
+		}
+
+		device_attr = &info->cell_attrs[index];
+		device_attr->cell = devm_nvmem_cell_get(dev, names[index]);
+		if (IS_ERR(device_attr->cell))
+			return dev_err_probe(dev, PTR_ERR(device_attr->cell),
+					     "failed to get NVMEM cell \"%s\"\n",
+					     names[index]);
+
+		cell_np = of_parse_phandle(dev->of_node, "nvmem-cells", index);
+		if (!cell_np)
+			return dev_err_probe(dev, -EINVAL,
+					     "failed to parse NVMEM cell \"%s\"\n",
+					     names[index]);
+		device_attr->bytes = of_property_read_bool(cell_np, "perle,bytes");
+		of_node_put(cell_np);
+
+		device_attr->bin_attr.attr.name =
+			devm_kstrdup(dev, names[index], GFP_KERNEL);
+		if (!device_attr->bin_attr.attr.name)
+			return -ENOMEM;
+
+		sysfs_bin_attr_init(&device_attr->bin_attr);
+		device_attr->bin_attr.attr.mode = 0444;
+		device_attr->bin_attr.read = perle_device_info_read;
+		info->bin_attrs[index] = &device_attr->bin_attr;
+	}
+
+	info->group.bin_attrs = info->bin_attrs;
+	platform_set_drvdata(pdev, info);
+
+	ret = devm_device_add_group(dev, &info->group);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to create sysfs attributes\n");
+
+	return 0;
+}
+
+static const struct of_device_id perle_device_info_of_match[] = {
+	{ .compatible = "perle,device-info" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, perle_device_info_of_match);
+
+static struct platform_driver perle_device_info_driver = {
+	.probe = perle_device_info_probe,
+	.driver = {
+		.name = "perle-device-info",
+		.of_match_table = perle_device_info_of_match,
+	},
+};
+module_platform_driver(perle_device_info_driver);
+
+MODULE_DESCRIPTION("Perle device information NVMEM consumer");
