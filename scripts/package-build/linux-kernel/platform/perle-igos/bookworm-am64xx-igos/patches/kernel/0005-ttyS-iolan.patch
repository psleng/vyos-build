+/* From void serial8250_tx_chars(struct uart_8250_port *up) in 8250_port.c*/
+void perle_serial8250_tx_chars(struct uart_8250_port *up)
+{
+	struct uart_port *port = &up->port;
+	struct tty_port *tport = &port->state->port;
+	int count;
+
+#ifdef CONFIG_PERLE_IOLAN
+	int tracing = (up->traceMask & TRACE_BITS_OUT);
+	uint8_t tracebuf[MAX_TRACE_DATA];
+	int tracelen = 0;
+	int rts_toggle_delay;
+	int tmp_mcr;
+	int tmp_msr;
+#endif
+#ifdef PERLE_SERIAL_DEBUG
+	printk_deferred("perle_tx_chars: ENTRY rts_toggle=%d fifo_len=%d\n",
+		up->rs232_rts_toggle, kfifo_len(&tport->xmit_fifo));
+#endif
+	if (port->x_char)
+	{
+		uart_xchar_out(port, UART_TX);
+#ifdef CONFIG_PERLE_IOLAN
+		if(up->port.rs485.flags & SER_RS485_ECHO_SUPPRESSION)
+			up->port.rs485_txing_no_echo = 1;
+		if(tracing)
+			uartTraceAdd(up->tracePortIndex, TRACE_OUT, 1, &up->port.x_char);
+		port->icount.tx++;
+		port->x_char = 0;
+#endif
+		return;
+	}
+
+#ifdef CONFIG_PERLE_IOLAN
+	if (!up->rs232_rts_toggle)
+	{
+#endif
+		if (uart_tx_stopped(port))
+		{
+			serial8250_stop_tx(port);
+			return;
+		}
+		if (kfifo_is_empty(&tport->xmit_fifo))
+		{
+			__stop_tx(up);
+			return;
+		}
+#ifdef CONFIG_PERLE_IOLAN
+		if(up->port.rs485.flags & SER_RS485_ECHO_SUPPRESSION)
+			up->port.rs485_txing_no_echo = 1;
+	}
+	else
+	{
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		printk_deferred("perle_tx_chars: RTS toggle path, fifo_len=%d\n",
+			kfifo_len(&tport->xmit_fifo));
+		printk_deferred("(%s,%d): starting, RTS toggle enabled\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+#endif /* CONFIG_PERLE_IOLAN */
+		if (kfifo_is_empty(&tport->xmit_fifo))
+		{
+#ifdef CONFIG_PERLE_IOLAN
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("perle_tx_chars: fifo empty, stopping TX\n");
+#endif
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+			printk_deferred("(%s,%d): no data to send\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			serial8250_stop_tx(&up->port);
+			tmp_mcr = serial_in(up, UART_MCR);
+			if (tmp_mcr & UART_MCR_RTS)
+			{
+				rts_toggle_delay = serial_in_UART_TXCNT(up);
+				if (rts_toggle_delay == 0)
+					rts_toggle_delay = 1;
+				rts_toggle_delay *= up->rs232_rts_toggle_char_timeout * HZ / 1000;
+				if (up->rts_toggle_final_delay)
+					rts_toggle_delay += up->rts_toggle_final_delay * HZ / 1000;
+				mod_timer(&up->rs232_rts_toggle_timer, jiffies + rts_toggle_delay);
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("perle_tx_chars: scheduled timer, delay=%d\n", rts_toggle_delay);
+#endif
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): buffer empty, set rs232_rts_toggle_timer, %d\n", __FUNCTION__, __LINE__,rts_toggle_delay);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			}
+			return;
+		}
+		else // have data to send
+		{
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("perle_tx_chars: have data, mcr=0x%x\n", serial_in(up, UART_MCR));
+#endif
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+			printk_deferred("(%s,%d): have data to send\n",__FUNCTION__,__LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			tmp_mcr = serial_in(up, UART_MCR);
+			if (!(tmp_mcr & UART_MCR_RTS))
+			{
+				tmp_mcr |= UART_MCR_RTS;
+				serial8250_out_MCR(up, tmp_mcr);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): assert RTS, mcr=0x%x\n", __FUNCTION__, __LINE__, tmp_mcr);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+				tmp_msr = perle_serial_in_msr(up);
+				if (!(tmp_msr & UART_MSR_CTS) || (up->rts_toggle_initial_delay))
+				{
+#ifdef PERLE_SERIAL_DEBUG
+					printk_deferred("perle_tx_chars: waiting for CTS or initial_delay, msr=0x%x delay=%d\n",
+						tmp_msr, up->rts_toggle_initial_delay);
+#endif
+					serial8250_stop_tx(&up->port);
+					rts_toggle_delay = (up->rts_toggle_initial_delay+1) * HZ / 1000;
+					mod_timer(&up->rs232_rts_toggle_initial_timer, jiffies + rts_toggle_delay);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+					printk_deferred("(%s,%d): set rs232_rts_toggle_initial_timer, %d\n", __FUNCTION__, __LINE__, rts_toggle_delay);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+					return;
+				}
+			}
+#ifdef PERLE_SERIAL_DEBUG
+			else
+			{
+				printk_deferred("perle_tx_chars: RTS already high, mcr=0x%x\n", tmp_mcr);
+			}
+#endif
+			if (uart_tx_stopped(&up->port))
+			{
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("perle_tx_chars: uart_tx_stopped, returning\n");
+#endif
+				serial8250_stop_tx(&up->port);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): tx stopped\n",__FUNCTION__,__LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+				return;
+			}
+			if (timer_pending(&up->rs232_rts_toggle_initial_timer))
+			{
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("perle_tx_chars: initial_timer pending, returning\n");
+#endif
+				serial8250_stop_tx(&up->port);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): rs232_rts_toggle_initial_timer is pending\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+				return;
+			}
+			if (timer_pending(&up->rs232_rts_toggle_timer))
+			{
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("perle_tx_chars: deleting pending rts_toggle_timer\n");
+#endif
+				timer_delete(&up->rs232_rts_toggle_timer);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): delete rs232_rts_toggle_timer\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			}
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("perle_tx_chars: proceeding to TX loop\n");
+#endif
+		}
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		printk_deferred("(%s,%d): tx chars, %d\n", __FUNCTION__, __LINE__, up->port.icount.tx);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */	
+#else /* CONFIG_PERLE_IOLAN */
+		__stop_tx(up);
+		return;
+#endif /* CONFIG_PERLE_IOLAN */
+	}
+
+	count = up->tx_loadsz;
+	do {
+		unsigned char c;
+
+		/* uart_fifo_get() pops from xmit_fifo; no explicit slot clear is needed. */
+		if (!uart_fifo_get(port, &c))
+			break;
+
+		serial_out(up, UART_TX, c);
+#ifdef CONFIG_PERLE_IOLAN
+		if (tracing)
+		{
+			tracebuf[tracelen++]=c;
+			if ((tracelen >= MAX_TRACE_DATA) || (tracelen >= sizeof(tracebuf)))
+			{
+				uartTraceAdd(up->tracePortIndex, TRACE_OUT, tracelen, &tracebuf[0]);
+				tracelen=0;	 // reset the trace buffer
+			}
+		}
+#endif /* CONFIG_PERLE_IOLAN */
+		if (up->bugs & UART_BUG_TXRACE)
+		{
+			/*
+			 * The Aspeed BMC virtual UARTs have a bug where data
+			 * may get stuck in the BMC's Tx FIFO from bursts of
+			 * writes on the APB interface.
+			 *
+			 * Delay back-to-back writes by a read cycle to avoid
+			 * stalling the VUART. Read a register that won't have
+			 * side-effects and discard the result.
+			 */
+			serial_in(up, UART_SCR);
+		}
+#ifdef CONFIG_PERLE_IOLAN
+		if (kfifo_is_empty(&tport->xmit_fifo))
+		{
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+			if (up->rs232_rts_toggle)
+				printk_deferred("(%s,%d): no more data to send\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			tmp_mcr = serial_in(up, UART_MCR);
+			if ((up->rs232_rts_toggle) && (tmp_mcr & UART_MCR_RTS))
+			{
+				rts_toggle_delay = serial_in_UART_TXCNT(up);
+				if (rts_toggle_delay == 0)
+					rts_toggle_delay = 1;
+				rts_toggle_delay *= up->rs232_rts_toggle_char_timeout * HZ / 1000;
+				if (up->rts_toggle_final_delay)
+					rts_toggle_delay += up->rts_toggle_final_delay * HZ / 1000;
+				mod_timer(&up->rs232_rts_toggle_timer, jiffies + rts_toggle_delay);
+#ifdef PERLE_SERIAL_DEBUG
+				printk_deferred("perle_tx_chars: loop done, scheduled timer, delay=%d mcr=0x%x\n", rts_toggle_delay, tmp_mcr);
+#endif
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+				printk_deferred("(%s,%d): no more data, set rs232_rts_toggle_timer, %d\n",__FUNCTION__,__LINE__,rts_toggle_delay);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+			}
+			break;
+		}
+#endif /* CONFIG_PERLE_IOLAN */
+		if ((up->capabilities & UART_CAP_HFIFO) &&
+			!uart_lsr_tx_empty(serial_in(up, UART_LSR)))
+			break;
+		/* The BCM2835 MINI UART THRE bit is really a not-full bit. */
+		if ((up->capabilities & UART_CAP_MINI) &&
+			!(serial_in(up, UART_LSR) & UART_LSR_THRE))
+			break;
+	} while (--count > 0);
+
+#ifdef CONFIG_PERLE_IOLAN
+	if (tracing && tracelen)
+		uartTraceAdd(up->tracePortIndex, TRACE_OUT, tracelen, &tracebuf[0]);
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+	if (up->rs232_rts_toggle)
+		printk_deferred("(%s,%d): done tx chars, %d\n", __FUNCTION__, __LINE__, up->port.icount.tx);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+#endif /* CONFIG_PERLE_IOLAN */
+
+	if (kfifo_len(&tport->xmit_fifo) < WAKEUP_CHARS)
+#ifdef CONFIG_PERLE_IOLAN
+	{
+#ifdef SERIAL_DEBUG_RTSTOGGLE
+		if (up->rs232_rts_toggle)
+			printk_deferred("(%s,%d): write wakeup\n", __FUNCTION__, __LINE__);
+#endif /* SERIAL_DEBUG_RTSTOGGLE */
+		uart_write_wakeup(port);
+	}
+#else /* CONFIG_PERLE_IOLAN */
+		uart_write_wakeup(port);
+#endif /* CONFIG_PERLE_IOLAN */
+
+	/*
+	 * With RPM enabled, we have to wait until the FIFO is empty before the
+	 * HW can go idle. So we get here once again with empty FIFO and disable
+	 * the interrupt and RPM in __stop_tx()
+	 */
+#ifdef CONFIG_PERLE_IOLAN
+	if(!up->port.rs485_txing_no_echo)
+	{
+#endif /* CONFIG_PERLE_IOLAN */
+		if (kfifo_is_empty(&tport->xmit_fifo) &&
+			!(up->capabilities & UART_CAP_RPM))
+			__stop_tx(up);
+#ifdef CONFIG_PERLE_IOLAN
+	}
+#endif /* CONFIG_PERLE_IOLAN */
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_tx_chars);
+
+int perle_serial8250_get_rs232_rts_toggle(struct uart_port *port)
+{
+	struct uart_8250_port *up = up_to_u8250p(port);
+
+	return(up->rs232_rts_toggle);
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_get_rs232_rts_toggle);
