+void perle_sigScanDefault(struct uart_8250_port *up)
+{
+	memset(&up->sigScan, 0, sizeof(struct sigscan));
+	up->sigScan.line = 0xffff;
+}
+
+int perle_fsmSigScan(struct uart_8250_port *up, int event, int data, int caller)
+{
+	int pid = up->sigScan.pid;
+//	struct uart_port *port = &up->port;	// SVT
+	int proc;
+
+	proc = perle_getProcSigScan(up->sigScan.line);
+#ifdef PERLE_SERIAL_DEBUG
+	printk_deferred("%s()@%d: pid=%d line=%d event=%d data=%x proc=%d caller=%d\n",__FUNCTION__,__LINE__, pid, up->sigScan.line, event, data, proc, caller);
+#endif
+	if(proc < 0)
+		return(-1);
+
+	switch(event)
+	{
+	case FSMSS_TIMEOUT:
+	case FSMSS_EXIT:
+		timer_delete(&up->sigscan_delay_timer);
+		perle_setProcSigScan(up->sigScan.line, PROCSS_NONE);
+		if(pid)
+			perle_send_signal(pid, SIGUSR1, 1);
+		perle_sigScanDefault(up);
+		break;
+	case FSMSS_SCAN:
+		perle_setProcSigScan(up->sigScan.line, PROCSS_SCAN);
+		if(pid)
+			perle_send_signal(pid, SIGUSR1, 1);
+		break;
+	case FSMSS_TIOCM:
+		if(pid == 0)
+			break;
+		switch(proc)
+		{
+		case PROCSS_SCAN:
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("%s %d %x\n", __FUNCTION__, __LINE__, up->sigScan.sigmask);
+#endif
+			if((data & up->sigScan.sigmask) == up->sigScan.sigmask)
+			{
+				perle_setProcSigScan(up->sigScan.line, PROCSS_START);
+				perle_send_signal(pid, SIGUSR1, 1);
+			}
+			break;
+		case PROCSS_START:
+			if((data & up->sigScan.sigmask) != up->sigScan.sigmask)
+			{
+				int delay = (up->sigScan.msec * HZ / 1000) + 1;
+				// serial8250_set_mctrl(up->port, up->sigScan.sigdrop);
+				perle_setProcSigScan(up->sigScan.line, PROCSS_DELAY);
+				perle_send_signal(pid, SIGUSR1, 1);
+
+				if(up->forwarding & (DS_FORWARD_ON_TIME|DS_FORWARD_ON_IDLE|DS_FORWARD_ON_COUNT))
+				{
+					unsigned long flags;
+
+					local_irq_save(flags);
+// SVT oops					spin_lock_irqsave(&port->lock, flags);
+					if(up->count != 0)
+						forward_frame(up);  // send any data we are holding
+					up->forwarding &= ~(DS_FORWARD_ON_TIME|DS_FORWARD_ON_IDLE|DS_FORWARD_ON_COUNT); // no more forwarding...
+					local_irq_restore(flags);
+// SVT oops					spin_unlock_irqrestore(&port->lock, flags);
+				}
+
+				mod_timer(&up->sigscan_delay_timer, jiffies + delay);
+			}
+			break;
+		case PROCSS_DELAY:
+#ifdef PERLE_SERIAL_DEBUG
+			printk_deferred("%s %d %x\n", __FUNCTION__, __LINE__, up->sigScan.sigmask);
+#endif
+			if((data & up->sigScan.sigmask) == up->sigScan.sigmask)
+			{
+				timer_delete(&up->sigscan_delay_timer);
+				perle_setProcSigScan(up->sigScan.line, PROCSS_START);
+				perle_send_signal(pid, SIGUSR1, 1);
+			}
+			break;	
+		}
+		break;
+	default:
+		return(-1);
+	}
+
+	return(0);
+}
+
+void perle_serial8250_signal_timer(struct timer_list *t)
+{
+	struct uart_8250_port *up = timer_container_of(up, t, signal_timer);
+	struct uart_port *port = &up->port;
+
+	scoped_guard(uart_port_lock_irq, port)
+	{
+		if (up->signal_count > SIGNAL_TIMER_CNT_MAX)
+		{
+			up->ier |= UART_IER_MSI;
+			serial_port_out(port, UART_IER, up->ier);  /* enable interrupts */
+		}
+		up->signal_count = 0;
+		mod_timer(&up->signal_timer, jiffies + SIGNAL_TIMER_TM);
+	}
+}
+EXPORT_SYMBOL_GPL(perle_serial8250_signal_timer);
