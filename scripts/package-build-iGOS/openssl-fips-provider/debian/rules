#!/usr/bin/make -f
# Package the PINNED, VALIDATED OpenSSL 3.1.2 FIPS provider (fips.so).
# The binary is NOT built here — it is a frozen, pre-validated artifact staged
# under fips/<arch>/fips.so and verified (optionally) against fips/SHA256SUMS.
# See docs/igos-fips-140-3-design.md §7.5 / §8.1 and ./README.md.

export DH_VERBOSE = 1

DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_HOST_ARCH      ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)

PKGDIR  = debian/igos-openssl-fips-provider
MODDIR  = usr/lib/$(DEB_HOST_MULTIARCH)/ossl-modules
PROVIDER = fips/$(DEB_HOST_ARCH)/fips.so
# Arch-qualified (the SHA differs per arch; the package is Multi-Arch: same).
# vyos-1x reads this to prove the loaded module is this exact build.
MANIFEST_DIR = usr/lib/$(DEB_HOST_MULTIARCH)/igos-openssl-fips-provider
# Version the provider must self-report: the upstream part of the package
# version (3.1.2-1igosN -> 3.1.2), i.e. the pinned OpenSSL FIPS release.
PROVIDER_VERSION := $(shell dpkg-parsechangelog -SVersion | sed -e 's/-[^-]*$$//')

%:
	dh $@

# Nothing to compile/configure/test — the provider is a pinned binary.
override_dh_auto_build:
override_dh_auto_configure:
override_dh_auto_test:

# The validated module must ship byte-for-byte as built: dh_strip/dh_dwz would
# rewrite fips.so (strip .symtab, add .gnu_debuglink), so it would no longer be
# the pinned binary and would not match the identity manifest checked on target.
override_dh_strip:
override_dh_dwz:

override_dh_auto_install:
	@set -e; \
	if [ ! -f "$(PROVIDER)" ]; then \
	  echo "E: pinned validated FIPS provider missing for arch '$(DEB_HOST_ARCH)':"; \
	  echo "E:   expected $(PROVIDER)"; \
	  echo "E: Stage the validated OpenSSL 3.1.2 fips.so there (see README.md)."; \
	  echo "E: Until then, do NOT add 'igos-openssl-fips-provider' to any flavor's"; \
	  echo "E: packages = [...] list."; \
	  exit 1; \
	fi; \
	case "$$(head -c 4 "$(PROVIDER)" | od -An -tx1 | tr -d ' \n')" in \
	  7f454c46) : ;; \
	  *) echo "E: $(PROVIDER) is not an ELF shared object (placeholder?)."; \
	     echo "E: Stage the real validated fips.so (see README.md)."; exit 1 ;; \
	esac; \
	if [ -f fips/SHA256SUMS ]; then \
	  echo "I: verifying pinned provider against fips/SHA256SUMS"; \
	  ( cd fips && sha256sum -c --ignore-missing --strict SHA256SUMS ) \
	    || { echo "E: pinned fips.so failed SHA256 verification"; exit 1; }; \
	else \
	  echo "W: no fips/SHA256SUMS — shipping provider WITHOUT hash pinning check"; \
	fi
	@set -e; \
	sha=$$(./check-fips-provider.sh "$(PROVIDER)" "$(PROVIDER_VERSION)"); \
	install -d $(PKGDIR)/$(MODDIR) $(PKGDIR)/$(MANIFEST_DIR); \
	install -m 0644 "$(PROVIDER)" $(PKGDIR)/$(MODDIR)/fips.so; \
	printf '%s\n' \
	  '# Identity of the validated OpenSSL FIPS provider shipped by' \
	  '# igos-openssl-fips-provider. vyos-1x refuses to enable FIPS mode unless' \
	  '# /$(MODDIR)/fips.so matches sha256 and the loaded provider reports version.' \
	  "version=$(PROVIDER_VERSION)" \
	  "sha256=$$sha" > $(PKGDIR)/$(MANIFEST_DIR)/fips.so.manifest; \
	echo "I: installed validated fips.so $(PROVIDER_VERSION) ($$sha) -> /$(MODDIR)/fips.so"
