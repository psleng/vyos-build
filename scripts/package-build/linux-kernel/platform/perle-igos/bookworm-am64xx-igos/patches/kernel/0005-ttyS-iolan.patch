+static void trptsetpid_handler(struct uart_port *port,unsigned long arg)
+{
+	struct uart_8250_port *up = up_to_u8250p(port);
+	if ( arg > 0)
+	{
+		up->rpt_pid = arg;
+	}
+	else
+	{
+		up->rpt_pid = 0;
+		up->rpt_mode = TRPT_OFF;
+		up->rpt_sigmask = 0;
+		up->rpt_user_sigmask = 0;
+		up->rpt_lsrmask = 0;
+		up->rpt_LSR = 0;
+	}
+}
