diff --git a/drivers/perle/perle_info.c b/drivers/perle/perle_info.c
new file mode 100644
index 000000000000..606a7bdb9249
--- /dev/null
+++ b/drivers/perle/perle_info.c
@@ -0,0 +1,153 @@
+/*
+ * read led, header info, switch status
+ * write led.
+ */
+
+#include <linux/module.h>
+#include <linux/kernel.h>
+#include <linux/init.h>
+#include <linux/proc_fs.h>
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/i2c.h>
+#include <linux/delay.h>
+
+#include <linux/ctype.h>
+#include <linux/of.h>
+
+#define MODULE_VERSION_STR "3.1"
+#define MODULE_NAME "perle"
+
+static struct proc_dir_entry *perle_dir;
+
+char procSigScan[256];	// one for each port
+
+static ssize_t proc_read_signal_scan(struct file *file, char __user *buf, size_t size, loff_t *ppos)
+{
+    int len;
+    
+    if (*ppos==0)
+    {
+        /* fill the buffer, return the buffer size */
+        if(copy_to_user(buf, procSigScan, sizeof(procSigScan)))
+			return -EFAULT;
+        len = sizeof(procSigScan);
+        *ppos=len;
+    }
+    else
+    {
+        len=0;
+    }
+    return len;
+}
+
+/*
+    currently does nothing
+*/
+static ssize_t proc_write_signal_scan(struct file *file, const char __user *buf, size_t size, loff_t *ppos)
+{
+    return(size);
+}
+
+static const struct proc_ops signal_scan_fops = {
+    // .owner = THIS_MODULE,
+    .proc_read  = proc_read_signal_scan,
+    .proc_write = proc_write_signal_scan,
+};
+
+typedef struct
+{
+    const char *filename;
+    const struct proc_ops *fops;
+} proc_file_table_t;
+
+
+proc_file_table_t proc_file_table[]={
+/*************************** COMMON ******************************/
+        {"signal_scan",                     &signal_scan_fops},
+        {NULL,NULL},
+};
+
+static int __init init_procfs_perle(void)
+{
+    struct proc_dir_entry *proc_file;
+    int rv = 0;
+    int i;
+    
+    /* create directory */
+    perle_dir = proc_mkdir(MODULE_NAME, NULL);
+    if(perle_dir == NULL)
+    {
+        rv = -ENOMEM;
+    }
+    else
+    {
+        for (i=0;proc_file_table[i].filename!=NULL;i++)
+        {
+            proc_file = proc_create(proc_file_table[i].filename,0644, perle_dir,proc_file_table[i].fops);
+            if(proc_file == NULL)
+            {
+                rv  = -ENOMEM;
+                break;
+            }
+        }
+
+        if (rv!=0)
+        {
+            /*
+             * an error occurred creating the last proc file
+             * start removing the proc files at the previous one
+             */
+            for (i--;i>0;i--)
+            {
+                remove_proc_entry(proc_file_table[i].filename, perle_dir);
+            }
+            remove_proc_entry(MODULE_NAME, NULL);   // now remove the /proc/perle directory
+            return rv;
+        }
+        else
+        {
+// #ifdef CONFIG_PERLE_X86_HARDWARE
+// 			if(bdinfoLen == 0)
+// 				printk(KERN_INFO "%s %s BDINFO missing?\n",
+// 						MODULE_NAME, MODULE_VERSION_STR);				
+// #else
+// 			printk(KERN_INFO "%s %s BDINFO initialising\n",
+//                    MODULE_NAME, MODULE_VERSION_STR);
+//             bdinfoInit();
+// #endif      
+            /* everything OK */
+            printk(KERN_INFO "%s %s initialised\n",
+                   MODULE_NAME, MODULE_VERSION_STR);
+        }
+    }
+    return(rv);
+}
+
+
+static void __exit cleanup_procfs_perle(void)
+{
+    int i;
+    for (i=0;proc_file_table[i].filename!=NULL;i++)
+    {
+        remove_proc_entry(proc_file_table[i].filename, perle_dir);
+    }
+	remove_proc_entry(MODULE_NAME, NULL);
+	printk(KERN_INFO "%s %s removed\n",
+	       MODULE_NAME, MODULE_VERSION_STR);
+}
+
+//late_initcall(init_i2c_hardware);
+
+
+
+
+module_init(init_procfs_perle);
+module_exit(cleanup_procfs_perle);
+
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("perle");
+MODULE_DESCRIPTION("procfs for perle console server");
+
