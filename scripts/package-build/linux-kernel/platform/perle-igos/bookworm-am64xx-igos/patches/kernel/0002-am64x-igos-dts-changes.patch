+&main_i2c0 {
+	bootph-all;
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_i2c0_pins_default>;
+	clock-frequency = <400000>;
+
+	eeprom@50 {
+		/* AT24C04D */
+		compatible = "atmel,24c04";
+		reg = <0x50>;
+		pagesize = <16>;
+		vcc-supply = <&reg_3v3>;
+		nvmem-layout {
+			compatible = "fixed-layout";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			
+			serial: serial@10 {
+				reg = <0x10 0x10>;
+			};
+
+			product: product@20 {
+				reg = <0x20 0x10>;
+			};	
+
+			model: model@30 {
+				reg = <0x30 0x10>;
+			};
+
+			wifi_mac_addr0: mac-address@be {
+				reg = <0xbe 0x6>;
+			};
+
+			wifi_mac_addr1: mac-address@c4 {
+				reg = <0xc4 0x6>;
+			};
+
+			mac_addr0: mac-address@ca {
+				reg = <0xca 0x6>;
+			};
+
+			mac_addr1: mac-address@d0 {
+				reg = <0xd0 0x6>;
+			};
+
+			mac_addr2: mac-address@d6 {
+				reg = <0xd6 0x6>;
+			};
+
+			mac_addr3: mac-address@dc {
+				reg = <0xdc 0x6>;
+			};
+
+			mac_addr4: mac-address@e2 {
+				reg = <0xe2 0x6>;
+			};
+
+			mac_addr5: mac-address@e8 {
+				reg = <0xe8 0x6>;
+			};
+
+			mac_addr6: mac-address@ee {
+				reg = <0xee 0x6>;
+			};
+
+			mac_addr7: mac-address@f4 {
+				reg = <0xf4 0x6>;
+			};
+
+			mac_addr8: mac-address@fa {
+				reg = <0xfa 0x6>;
+			};
+		};
+	};
+
+	rtc_rv3028: rtc@52 {
