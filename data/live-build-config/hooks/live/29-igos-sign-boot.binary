#!/bin/sh
# igOS: secure-boot signing — GPG detached-sign the FINAL kernel + initrd and
#   the per-model device-tree blobs (the only artifacts the enforcing GRUB core
#   loads + verifies from disk).
#
# WHY (this is a .binary hook, numbered AFTER 28-igos-dm-verity.binary)
#   The initrd is only final AFTER 28 appends the dm-verity root hash to it, so
#   the detached signature must be produced here, at the binary stage, once
#   live/initrd.img (and the kernel) are their final bytes. The custom enforcing
#   GRUB core (built by 25-igos-grub-core.chroot, MONOLITHIC: every module it
#   needs is embedded) verifies <file>.sig only for what it loads from disk --
#   the kernel, the initrd, and the per-image dtb. It never autoloads grub
#   modules from disk, so on-disk *.mod/*.lst and UI assets need NO signature.
#   The kernel/initrd .sig ride in /live; the dtb .sig ride in boot/dtb (both
#   copied per-image by the installer into /boot/<version>/), so no menuentry
#   changes are needed.
#
# SIGNING IS INDEPENDENT OF DM-VERITY (decoupled by request)
#   Signing is driven by the per-flavor `sign_boot` flag: build-vyos-image
#   stages the signing key + passphrase under ../signing/ ONLY when the flavor
#   sets sign_boot = true, so the mere presence of ../signing/gpg-signing-key.asc
#   (host-only, never shipped) is this hook's gate. dm-verity is a separate,
#   flavor-driven feature (dm_verity in the build flavor, applied by hook 28);
#   the two are orthogonal:
#     - sign_boot = true  -> kernel + initrd are detached-signed (this hook)
#     - dm_verity = true  -> root squashfs sealed + hash baked into initrd (hook 28)
#   Any combination is valid. Signature ENFORCEMENT lives in the custom grub
#   (embeds the public half), wired separately. This hook still runs AFTER 28 so
#   that on verity builds it signs the initrd in its FINAL (hash-appended) form;
#   on non-verity builds 28 is a no-op and the initrd is already final.
#
# KEY HANDLING
#   The private key is imported into a throwaway GNUPGHOME and removed on exit.
#   build-vyos-image stages the passphrase-protected secret key AND its
#   passphrase (both discovered by glob in --gpg-signing-key-dir) under
#   ../signing/, OUTSIDE chroot/ and binary/ so they never enter the ISO, and
#   deletes them after `lb build`. The passphrase is supplied non-interactively
#   via --passphrase-file (gpg loopback pinentry). No fallback: a staged key
#   without its passphrase fails the build closed.

set -e

# --- gate: did build-vyos-image stage signing material? (flavor sign_boot=true) ---
KEY=""
for k in ../signing/gpg-signing-key.asc signing/gpg-signing-key.asc \
         ../../signing/gpg-signing-key.asc; do
    if [ -f "${k}" ]; then
        KEY="${k}"
        break
    fi
done
if [ -z "${KEY}" ]; then
    echo "I: sign-boot(iso): no signing material staged (flavor sign_boot != true) -- kernel/initrd left UNSIGNED"
    exit 0
fi

# The passphrase is staged next to the key by build-vyos-image. No fallback:
# a staged key with no passphrase must fail closed, never sign passphrase-less.
PASS="$(dirname "${KEY}")/gpg-signing-passphrase"
if [ ! -f "${PASS}" ]; then
    echo "E: sign-boot(iso): signing key staged but passphrase file missing at ${PASS}"
    echo "E: sign-boot(iso): refusing to fall back to unsigned/passphrase-less -- failing closed"
    exit 1
fi

echo "I: sign-boot(iso): signing key + passphrase found, signing final kernel + initrd"

# --- import the key into a throwaway keyring ---------------------------------
command -v gpg >/dev/null 2>&1 || {
    echo "E: sign-boot(iso): gpg not found on the build host"
    exit 1
}

GNUPGHOME_TMP="$(mktemp -d)"
export GNUPGHOME="${GNUPGHOME_TMP}"
chmod 700 "${GNUPGHOME_TMP}"
cleanup() { gpgconf --kill gpg-agent >/dev/null 2>&1 || true; rm -rf "${GNUPGHOME_TMP}"; }
trap cleanup EXIT INT TERM

# There is NO interactive user during the build. Permit gpg-agent to accept the
# passphrase from --passphrase-file (loopback pinentry), and force any pinentry
# attempt to fail immediately (pinentry-program /bin/false) so the build can
# never hang or pop a prompt waiting for a human.
{
    echo "allow-loopback-pinentry"
    echo "pinentry-program /bin/false"
} > "${GNUPGHOME_TMP}/gpg-agent.conf"
gpgconf --kill gpg-agent >/dev/null 2>&1 || true

if ! gpg --batch --quiet --import "${KEY}"; then
    echo "E: sign-boot(iso): failed to import signing key ${KEY}"
    exit 1
fi

# First available secret key (long key id).
KEYID="$(gpg --list-secret-keys --with-colons 2>/dev/null | awk -F: '/^sec:/ { print $5; exit }')"
if [ -z "${KEYID}" ]; then
    echo "E: sign-boot(iso): no secret key found in ${KEY}"
    exit 1
fi
echo "I: sign-boot(iso): using signing key ${KEYID}"

# --- detached-sign every boot artifact grub may load -------------------------
# The plain names (installed path: /boot/<ver>/{vmlinuz,initrd.img}) and the
# versioned names (live ISO grub.cfg: /live/{vmlinuz,initrd.img}-<ver>) are
# hardlinks to the same bytes; sign each so whichever filename grub references
# has a matching detached signature.
signed_any=0
for f in live/vmlinuz live/vmlinuz-* live/initrd.img live/initrd.img-*; do
    [ -f "${f}" ] || continue
    case "${f}" in *.sig) continue ;; esac
    if gpg --batch --yes --pinentry-mode loopback \
           --passphrase-file "${PASS}" \
           --digest-algo SHA512 --local-user "${KEYID}" \
           --detach-sign --output "${f}.sig" "${f}"; then
        echo "I: sign-boot(iso): wrote ${f}.sig"
        signed_any=1
    else
        echo "E: sign-boot(iso): failed to sign ${f}"
        exit 1
    fi
done

if [ "${signed_any}" -eq 0 ]; then
    echo "E: sign-boot(iso): no kernel/initrd found under live/ to sign"
    exit 1
fi

# --- detached-sign device-tree blobs (grub loads the dtb via `devicetree`) ----
# With GRUB (not U-Boot) loading the dtb, the load is a
# GRUB_FILE_TYPE_DEVICE_TREE_IMAGE file open, so an enforcing core checks
# <dtb>.sig. NOTE: the grub verifier patch MUST enforce that file type
# (kernel+initrd+module alone is not enough) or these .sig are inert. Sign every
# staged dtb AND its model.conf `dtb_alias` copy so whichever clean name the
# bootloader loads has a matching detached signature.
dtb_signed=0
if [ -d boot/dtb ]; then
    for f in $(find boot/dtb -type f -name '*.dtb' 2>/dev/null); do
        [ -f "${f}" ] || continue
        if gpg --batch --yes --pinentry-mode loopback \
               --passphrase-file "${PASS}" \
               --digest-algo SHA512 --local-user "${KEYID}" \
               --detach-sign --output "${f}.sig" "${f}"; then
            dtb_signed=$(( dtb_signed + 1 ))
        else
            echo "E: sign-boot(iso): failed to sign ${f}"
            exit 1
        fi
    done
fi
echo "I: sign-boot(iso): signed ${dtb_signed} device-tree blob(s)"

echo "I: sign-boot(iso): done"
