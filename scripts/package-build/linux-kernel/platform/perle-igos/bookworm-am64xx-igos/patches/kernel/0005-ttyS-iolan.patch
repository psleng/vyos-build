+static const struct uart_ops omap_port_ops = {
+    .set_mctrl = serial8250_set_mctrl,
+    .get_mctrl = serial8250_do_get_mctrl,
+    .break_ctl = serial8250_break_ctl,
+    .ioctl     = perle_serial8250_ioctl,
