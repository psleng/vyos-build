diff --git a/mlan/mlan_cmdevt.c b/mlan/mlan_cmdevt.c
index c8e98d8..873cdc6 100644
--- a/mlan/mlan_cmdevt.c
+++ b/mlan/mlan_cmdevt.c
@@ -1445,6 +1445,12 @@ static t_u32 wlan_get_cmd_timeout(t_u16 cmd_id)
 	case HostCmd_CMD_802_11_SCAN_EXT:
 #ifdef UAP_SUPPORT
 	case HostCmd_CMD_APCMD_SYS_CONFIGURE:
+	/* PSL: FW holds BSS start/stop until a scan on the other MAC of a
+	 * dual-MAC chip (e.g. 9098) completes, which can exceed 5s. Allow as
+	 * long as a scan so this does not trigger a spurious FW reset.
+	 */
+	case HostCmd_CMD_APCMD_BSS_START:
+	case HostCmd_CMD_APCMD_BSS_STOP:
 #endif
 		timeout = MRVDRV_TIMER_10S * 2;
 		break;
@@ -1464,8 +1470,6 @@ static t_u32 wlan_get_cmd_timeout(t_u16 cmd_id)
 	case HostCmd_CMD_SOFT_RESET:
 #ifdef UAP_SUPPORT
 	case HostCmd_CMD_APCMD_SYS_RESET:
-	case HostCmd_CMD_APCMD_BSS_START:
-	case HostCmd_CMD_APCMD_BSS_STOP:
 	case HostCmd_CMD_APCMD_STA_DEAUTH:
 #endif
 	case HostCmd_CMD_APCMD_ACS_SCAN:
