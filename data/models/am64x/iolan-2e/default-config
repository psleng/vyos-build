interfaces {
    bridge br1 {
        address 192.168.1.1/24
        address fd08::1/8
        member {
            interface wlan0 {
            }
            interface wlan1 {
            }
         }
    }
    ethernet eth0 {
        address dhcp
    }
    ethernet eth1 {
        address dhcp
    }
    loopback lo {
    }
    wireless wlan0 {
        capabilities {
            ht {
                channel-set-width ht20
                channel-set-width ht40+
                channel-set-width ht40-
                ldpc
            }
            vht {
                channel-set-width 0
                ldpc
            }
        }
        channel 0
        max-stations 16
        mode ac
        security {
            wpa {
                cipher GCMP
                cipher GCMP-256
                cipher CCMP-256
                cipher CCMP
                cipher TKIP
                mode wpa+wpa2
           }
        }
        stationary-ap
        type access-point
    }
    wireless wlan1 {
        capabilities {
            ht {
                channel-set-width ht20
                channel-set-width ht40+
                channel-set-width ht40-
                ldpc
            }
            vht {
                channel-set-width 0
                ldpc
            }
        }
        channel 0
        max-stations 16
        mode n
        physical-device phy1
        security {
            wpa {
                cipher GCMP
                cipher GCMP-256
                cipher CCMP-256
                cipher CCMP
                cipher TKIP
                mode wpa+wpa2
            }
        }
        stationary-ap
        type access-point
    }
    wireless wlan2 {
        disable
    }
    wireless wlan3 {
        disable
    }
}
nat {
    source {
        rule 10 {
            outbound-interface {
                name eth0
            }
            translation {
                address masquerade
            }
        }
        rule 20 {
            outbound-interface {
                name eth1
            }
            translation {
                address masquerade
            }
        }
    }
}
service {
    dhcp-server {
        listen-interface br1
        shared-network-name default-dhcp-pool {
            subnet 192.168.1.0/24 {
                option {
                    default-router 192.168.1.1
                    name-server 192.168.1.1
                }
                range range_1 {
                    start 192.168.1.100
                    stop 192.168.1.200
                }
                subnet-id 1
            }
        }
    }
    dns {
        forwarding {
            allow-from 0.0.0.0/0
            listen-address 192.168.1.1
        }
    }
    https {
        api {
            graphql {
                authentication {
                    type key
                }
            }
            keys {
                id myid {
                    key mykey
                }
            }
            rest {
            }
        }
        enable-http-redirect
    }
    ntp {
        allow-client {
            address "127.0.0.0/8"
            address "169.254.0.0/16"
            address "10.0.0.0/8"
            address "172.16.0.0/12"
            address "192.168.0.0/16"
            address "::1/128"
            address "fe80::/10"
            address "fc00::/7"
        }
        server 0.pool.ntp.org {
        }
        server 1.pool.ntp.org {
        }
        server 2.pool.ntp.org {
        }
    }
}
system {
    config-management {
        commit-revisions "100"
    }
    console {
        device ttyS0 {
            speed 115200
        }
    }
    host-name igos
    login {
        operator-group default {
            command-policy {
                allow "*"
            }
        }
        operator-group super-operator {
            command-policy {
                allow "*"
            }
        }
        user igos {
            authentication {
                encrypted-password '!'
                plaintext-password ""
            }
        }
    }
	name-server eth0
	name-server eth1
    option {
        reboot-on-upgrade-failure 5
    }
    static-host-mapping {
        host-name igos.lan {
            inet 192.168.1.1
        }
        host-name igos.lan6 {
            inet fd08::1
        }
    }
    syslog {
        local {
            facility all {
                level "info"
            }
            facility local7 {
                level "debug"
            }
        }
    }
    wireless {
        country-code 00
    }
}
