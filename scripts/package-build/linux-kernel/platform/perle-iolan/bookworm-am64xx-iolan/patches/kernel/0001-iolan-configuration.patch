+	main_pcie0_pins_default: main-pcie0-pins-default {
+	    pinctrl-single,pins = <
+			AM64X_IOPAD(0x0248, PIN_INPUT, 3) /* (D16) UART1_CTSn.PCIE0_CLKREQn */
+	    >;
+	};
